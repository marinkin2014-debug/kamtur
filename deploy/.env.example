# ============================================================
# Kamtur deploy — пример конфигурации
# ============================================================
#
# Скопируй в `deploy/.env` и заполни реальными значениями:
#
#     cp deploy/.env.example deploy/.env
#
# `deploy/.env` в .gitignore, никогда не коммитится.
#
# Docker Compose автоматически подхватывает `.env` рядом с
# `docker-compose.yml`.

# ---- Alertmanager: SMTP для алертов ----
#
# Пароль создаётся в Yandex ID: https://id.yandex.ru/security/app-passwords
# Приложение: "Почта", тип: "Пароль приложения".
# Старый пароль после ротации ОБЯЗАТЕЛЬНО отозвать.
SMTP_HOST=smtp.yandex.ru:465
SMTP_FROM=marketing@kamtur.ru
SMTP_USERNAME=marketing@kamtur.ru
SMTP_PASSWORD=REPLACE_WITH_YANDEX_APP_PASSWORD
SMTP_TO=marketing@kamtur.ru

# ---- Grafana ----
#
# Пароль admin-пользователя. Дефолт admin/admin небезопасен.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ---- Prometheus scrape targets ----
#
# Адреса, откуда Prometheus забирает метрики.
#
# Локально (docker-compose на одной машине с worker/api через systemd):
#   WORKER_TARGET=host.docker.internal:9090
#   API_TARGET=host.docker.internal:8080
#
# Прод (worker/api на отдельных VM в VPC):
#   WORKER_TARGET=10.10.0.11:9090
#   API_TARGET=10.10.0.12:8080
WORKER_TARGET=host.docker.internal:9090
API_TARGET=host.docker.internal:8080
